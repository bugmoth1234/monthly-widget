<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/pd_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="22sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/pd_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <ProgressBar
        android:id="@+id/pd_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="12dp"
        android:max="100" />
    <TextView
        android:id="@+id/pd_pct"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/pd_manual_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">
        <Button android:id="@+id/pd_minus" android:layout_width="56dp" android:layout_height="wrap_content" android:text="−" android:textSize="20sp" />
        <TextView
            android:id="@+id/pd_manual_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="16sp" />
        <Button android:id="@+id/pd_plus" android:layout_width="56dp" android:layout_height="wrap_content" android:text="+" android:textSize="20sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <Button android:id="@+id/pd_edit" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="편집" />
        <Button android:id="@+id/pd_link" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:text="작업 사이트" />
        <Button android:id="@+id/pd_delete" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:text="삭제" />
    </LinearLayout>

    <TextView style="@style/SectionLabel" android:text="체크리스트" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ListView
            android:id="@+id/pd_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/divider"
            android:dividerHeight="1dp" />
        <TextView
            android:id="@+id/pd_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="할 일이 없어요. 아래 버튼으로 추가해 보세요."
            android:textColor="@color/text_secondary" />
    </FrameLayout>

    <Button
        android:id="@+id/pd_add"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="+ 할 일 추가"
        android:textSize="16sp" />
</LinearLayout>
