<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:title="꾸미기" />

    <FrameLayout
        android:id="@+id/preview_outer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/preview_bg"
        android:padding="10dp">
        <FrameLayout
            android:id="@+id/preview_frame"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_gravity="center_horizontal">
            <FrameLayout
                android:id="@+id/preview_host"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
            <dev.monthly.widget.StickerEditView
                android:id="@+id/sticker_edit"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/preview_handle"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:background="@color/preview_bg"
        android:contentDescription="미리보기 크기 조절 손잡이">
        <FrameLayout
            android:id="@+id/preview_handle_pill"
            android:layout_width="44dp"
            android:layout_height="5dp"
            android:layout_gravity="center" />
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="스티커를 눌러 고른 뒤 끌어서 옮기고, 두 손가락으로 크기와 각도를 바꿀 수 있어요."
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="13sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">
            <LinearLayout
                android:id="@+id/sections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:minHeight="52dp"
                            android:orientation="horizontal"
                            android:paddingStart="16dp"
                            android:paddingEnd="12dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="추천 테마"
                                android:textAppearance="?attr/textAppearanceTitleSmall"
                                android:textColor="?attr/colorOnSurface" />
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_expand"
                                android:tag="arrow"
                                app:tint="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="14dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="누르면 색·배경·테두리·제목 모양이 한 번에 바뀌어요. 스티커와 사진, 글꼴은 그대로예요."
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="13sp" />
                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:scrollbars="none">
                            <LinearLayout
                                android:id="@+id/preset_row"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />
                        </HorizontalScrollView>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:minHeight="52dp"
                            android:orientation="horizontal"
                            android:paddingStart="16dp"
                            android:paddingEnd="12dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="스티커"
                                android:textAppearance="?attr/textAppearanceTitleSmall"
                                android:textColor="?attr/colorOnSurface" />
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_expand"
                                android:tag="arrow"
                                app:tint="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="14dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">
                            <Button style="@style/Widget.Material3.Button.TonalButton"
                                android:id="@+id/btn_add_sticker"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="+ 스티커 추가" />
                            <Button style="@style/Widget.Material3.Button.TonalButton"
                                android:id="@+id/btn_del_sticker"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:text="선택한 스티커 삭제" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <Button style="@style/Widget.Material3.Button.TonalButton"
                                android:id="@+id/btn_sticker_back"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="↓ 뒤로" />
                            <Button style="@style/Widget.Material3.Button.TonalButton"
                                android:id="@+id/btn_sticker_front"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:text="↑ 앞으로" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/sticker_size_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="선택한 스티커 크기" />
                        <SeekBar
                            android:id="@+id/seek_sticker_size"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="155" />

                        <TextView
                            android:id="@+id/bleed_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="카드 바깥 여백" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="여백을 주면 카드가 작아지고, 그 바깥으로 삐져나온 스티커는 바탕화면 위에 보여요."
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="13sp" />
                        <SeekBar
                            android:id="@+id/seek_bleed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="40" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:minHeight="52dp"
                            android:orientation="horizontal"
                            android:paddingStart="16dp"
                            android:paddingEnd="12dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="포인트 색"
                                android:textAppearance="?attr/textAppearanceTitleSmall"
                                android:textColor="?attr/colorOnSurface" />
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_expand"
                                android:tag="arrow"
                                app:tint="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="14dp">
                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:scrollbars="none">
                            <LinearLayout
                                android:id="@+id/accent_row"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />
                        </HorizontalScrollView>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="직접 고르기 (아래 막대를 움직이면 적용돼요)" />
                            <FrameLayout
                                android:id="@+id/accent_preview"
                                android:layout_width="36dp"
                                android:layout_height="36dp" />
                        </LinearLayout>
                        <TextView style="@style/SliderLabel" android:id="@+id/hue_label" android:text="색상" />
                        <SeekBar android:id="@+id/seek_hue" style="@style/ColorBar" android:max="359" />
                        <TextView style="@style/SliderLabel" android:id="@+id/sat_label" android:text="채도" />
                        <SeekBar android:id="@+id/seek_sat" style="@style/ColorBar" android:max="100" />
                        <TextView style="@style/SliderLabel" android:id="@+id/val_label" android:text="밝기(명도)" />
                        <SeekBar android:id="@+id/seek_val" style="@style/ColorBar" android:max="100" />
                        <TextView style="@style/SliderLabel" android:text="포인트 색 위 글자 (오늘 동그라미·디데이 배지)" />
                        <RadioGroup
                            android:id="@+id/on_accent_mode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <RadioButton android:id="@+id/rb_on_auto" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="자동" />
                            <RadioButton android:id="@+id/rb_on_white" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="흰색" />
                            <RadioButton android:id="@+id/rb_on_black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="검정" />
                        </RadioGroup>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:minHeight="52dp"
                            android:orientation="horizontal"
                            android:paddingStart="16dp"
                            android:paddingEnd="12dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="제목(몇 월) 배경 이미지"
                                android:textAppearance="?attr/textAppearanceTitleSmall"
                                android:textColor="?attr/colorOnSurface" />
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_expand"
                                android:tag="arrow"
                                app:tint="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="14dp">
                        <Button style="@style/Widget.Material3.Button.TonalButton"
                            android:id="@+id/btn_header_all"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="모든 달에 쓸 이미지 고르기" />
                        <Button style="@style/Widget.Material3.Button.TonalButton"
                            android:id="@+id/btn_header_month"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="이 달만 다른 이미지" />
                        <Button
                            android:id="@+id/btn_header_clear"
                            style="?android:attr/borderlessButtonStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="이 달에 보이는 제목 이미지 지우기" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="제목 이미지 어둡게 (글씨가 잘 보이게)" />
                        <SeekBar
                            android:id="@+id/seek_header_dim"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="80" />
                        <RadioGroup
                            android:id="@+id/header_size"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <RadioButton android:id="@+id/rb_header_normal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="얇게" />
                            <RadioButton android:id="@+id/rb_header_large" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="크게 (배너처럼)" />
                        </RadioGroup>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:minHeight="52dp"
                            android:orientation="horizontal"
                            android:paddingStart="16dp"
                            android:paddingEnd="12dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="배경"
                                android:textAppearance="?attr/textAppearanceTitleSmall"
                                android:textColor="?attr/colorOnSurface" />
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_expand"
                                android:tag="arrow"
                                app:tint="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="14dp">
                        <RadioGroup
                            android:id="@+id/bg_mode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <RadioButton android:id="@+id/rb_bg_default" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="기본" />
                            <RadioButton android:id="@+id/rb_bg_color" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="단색" />
                            <RadioButton android:id="@+id/rb_bg_photo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="사진" />
                        </RadioGroup>
                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:scrollbars="none">
                            <LinearLayout
                                android:id="@+id/bgcolor_row"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />
                        </HorizontalScrollView>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="배경색 직접 고르기 (막대를 움직이면 단색 배경으로 적용)" />
                            <FrameLayout
                                android:id="@+id/bg_preview"
                                android:layout_width="36dp"
                                android:layout_height="36dp" />
                        </LinearLayout>
                        <TextView style="@style/SliderLabel" android:id="@+id/bg_hue_label" android:text="색상" />
                        <SeekBar android:id="@+id/seek_bg_hue" style="@style/ColorBar" android:max="359" />
                        <TextView style="@style/SliderLabel" android:id="@+id/bg_sat_label" android:text="채도" />
                        <SeekBar android:id="@+id/seek_bg_sat" style="@style/ColorBar" android:max="100" />
                        <TextView style="@style/SliderLabel" android:id="@+id/bg_val_label" android:text="밝기(명도)" />
                        <SeekBar android:id="@+id/seek_bg_val" style="@style/ColorBar" android:max="100" />
                        <Button style="@style/Widget.Material3.Button.TonalButton"
                            android:id="@+id/btn_bg_photo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="배경 사진 고르기" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="배경 불투명도 (낮추면 바탕화면이 비쳐요)" />
                        <SeekBar
                            android:id="@+id/seek_alpha"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="100" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="사진 어둡게" />
                        <SeekBar
                            android:id="@+id/seek_dim"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="80" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:minHeight="52dp"
                            android:orientation="horizontal"
                            android:paddingStart="16dp"
                            android:paddingEnd="12dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="스타일"
                                android:textAppearance="?attr/textAppearanceTitleSmall"
                                android:textColor="?attr/colorOnSurface" />
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_expand"
                                android:tag="arrow"
                                app:tint="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="14dp">
                        <TextView style="@style/SliderLabel" android:text="제목 모양" />
                        <RadioGroup
                            android:id="@+id/title_style"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <RadioButton android:id="@+id/rb_title_ko" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2026년 11월" />
                            <RadioButton android:id="@+id/rb_title_en" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="November" />
                            <RadioButton android:id="@+id/rb_title_big" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="큰 숫자" />
                        </RadioGroup>
                        <TextView style="@style/SliderLabel" android:text="요일 표시" />
                        <RadioGroup
                            android:id="@+id/weekday_lang"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <RadioButton android:id="@+id/rb_week_ko" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="일 월 화" />
                            <RadioButton android:id="@+id/rb_week_en" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="SUN MON TUE" />
                        </RadioGroup>
                        <TextView style="@style/SliderLabel" android:text="테두리" />
                        <RadioGroup
                            android:id="@+id/border_style"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <RadioButton android:id="@+id/rb_border_none" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="없음" />
                            <RadioButton android:id="@+id/rb_border_line" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="얇은 선" />
                            <RadioButton android:id="@+id/rb_border_stitch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="스티치 (바느질)" />
                        </RadioGroup>
                        <CheckBox
                            android:id="@+id/cb_highlight"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="가장 가까운 디데이를 카드로 크게 보여주기" />
                        <CheckBox
                            android:id="@+id/cb_projects"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="위젯에 프로젝트 보여주기 (마감 가까운 2개)" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:minHeight="52dp"
                            android:orientation="horizontal"
                            android:paddingStart="16dp"
                            android:paddingEnd="12dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="글꼴"
                                android:textAppearance="?attr/textAppearanceTitleSmall"
                                android:textColor="?attr/colorOnSurface" />
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_expand"
                                android:tag="arrow"
                                app:tint="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="14dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="무료 한글 글꼴 파일(.ttf / .otf)을 휴대폰에 받아 두고 골라 주세요."
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="13sp" />
                        <TextView
                            android:id="@+id/title_font_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="제목 글꼴: 기본" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <Button style="@style/Widget.Material3.Button.TonalButton" android:id="@+id/btn_title_font" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:text="글꼴 파일 고르기" />
                            <Button style="@style/Widget.Material3.Button.TonalButton" android:id="@+id/btn_title_font_clear" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:text="기본으로" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/body_font_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="글자 글꼴 (요일·날짜·목록): 기본" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <Button style="@style/Widget.Material3.Button.TonalButton" android:id="@+id/btn_body_font" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:text="글꼴 파일 고르기" />
                            <Button style="@style/Widget.Material3.Button.TonalButton" android:id="@+id/btn_body_font_clear" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:text="기본으로" />
                        </LinearLayout>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="글자 크기 (글꼴 파일을 쓸 때)" />
                        <RadioGroup
                            android:id="@+id/font_scale"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <RadioButton android:id="@+id/rb_scale_s" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="작게" />
                            <RadioButton android:id="@+id/rb_scale_m" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="보통" />
                            <RadioButton android:id="@+id/rb_scale_l" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="크게" />
                        </RadioGroup>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:minHeight="52dp"
                            android:orientation="horizontal"
                            android:paddingStart="16dp"
                            android:paddingEnd="12dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="글자색 · 문구"
                                android:textAppearance="?attr/textAppearanceTitleSmall"
                                android:textColor="?attr/colorOnSurface" />
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_expand"
                                android:tag="arrow"
                                app:tint="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="14dp">
                        <RadioGroup
                            android:id="@+id/text_mode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <RadioButton android:id="@+id/rb_text_auto" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="자동" />
                            <RadioButton android:id="@+id/rb_text_dark" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="어둡게" />
                            <RadioButton android:id="@+id/rb_text_light" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="밝게" />
                        </RadioGroup>

                        <TextView style="@style/SliderLabel" android:text="위젯 문구 (제목 아래 한 줄)" />
                        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="예: 최애 생일까지 존버 중">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/input_caption" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:inputType="text"
                            android:maxLength="40"
                            android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
            <Button
                android:id="@+id/btn_reset"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="꾸미기 전부 초기화"
                android:textColor="?attr/colorError" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/bottom_nav" />
</LinearLayout>
