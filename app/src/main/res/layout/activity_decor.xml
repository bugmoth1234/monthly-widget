<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <FrameLayout
        android:id="@+id/preview_outer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/preview_bg"
        android:padding="12dp">
        <FrameLayout
            android:id="@+id/preview_frame"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_gravity="center_horizontal">
            <FrameLayout
                android:id="@+id/preview_host"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
            <dev.monthly.widget.StickerEditView
                android:id="@+id/sticker_edit"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="스티커를 눌러 고른 뒤 끌어서 옮기고, 두 손가락으로 크기와 각도를 바꿀 수 있어요."
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btn_add_sticker"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="+ 스티커 추가" />
        <Button
            android:id="@+id/btn_del_sticker"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="선택한 스티커 삭제" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btn_sticker_back"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="↓ 뒤로" />
        <Button
            android:id="@+id/btn_sticker_front"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="↑ 앞으로" />
    </LinearLayout>

    <TextView
        android:id="@+id/sticker_size_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="선택한 스티커 크기" />
    <SeekBar
        android:id="@+id/seek_sticker_size"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="155" />

    <TextView style="@style/SectionLabel" android:text="포인트 색" />
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/accent_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <TextView style="@style/SectionLabel" android:text="글꼴" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="무료 한글 글꼴 파일(.ttf / .otf)을 휴대폰에 받아 두고 골라 주세요."
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />
    <TextView
        android:id="@+id/title_font_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="제목 글꼴: 기본" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/btn_title_font" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:text="글꼴 파일 고르기" />
        <Button android:id="@+id/btn_title_font_clear" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:text="기본으로" />
    </LinearLayout>
    <TextView
        android:id="@+id/body_font_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="글자 글꼴 (요일·날짜·목록): 기본" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/btn_body_font" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:text="글꼴 파일 고르기" />
        <Button android:id="@+id/btn_body_font_clear" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:text="기본으로" />
    </LinearLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="글자 크기 (글꼴 파일을 쓸 때)" />
    <RadioGroup
        android:id="@+id/font_scale"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <RadioButton android:id="@+id/rb_scale_s" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="작게" />
        <RadioButton android:id="@+id/rb_scale_m" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="보통" />
        <RadioButton android:id="@+id/rb_scale_l" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="크게" />
    </RadioGroup>

    <TextView style="@style/SectionLabel" android:text="제목(몇 월) 배경 이미지" />
    <Button
        android:id="@+id/btn_header_all"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="모든 달에 쓸 이미지 고르기" />
    <Button
        android:id="@+id/btn_header_month"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="이 달만 다른 이미지" />
    <Button
        android:id="@+id/btn_header_clear"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="이 달에 보이는 제목 이미지 지우기" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="제목 이미지 어둡게 (글씨가 잘 보이게)" />
    <SeekBar
        android:id="@+id/seek_header_dim"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="80" />
    <RadioGroup
        android:id="@+id/header_size"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <RadioButton android:id="@+id/rb_header_normal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="얇게" />
        <RadioButton android:id="@+id/rb_header_large" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="크게 (배너처럼)" />
    </RadioGroup>

    <TextView style="@style/SectionLabel" android:text="배경" />
    <RadioGroup
        android:id="@+id/bg_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <RadioButton android:id="@+id/rb_bg_default" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="기본" />
        <RadioButton android:id="@+id/rb_bg_color" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="단색" />
        <RadioButton android:id="@+id/rb_bg_photo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="사진" />
    </RadioGroup>
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/bgcolor_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>
    <Button
        android:id="@+id/btn_bg_photo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="배경 사진 고르기" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="배경 불투명도 (낮추면 바탕화면이 비쳐요)" />
    <SeekBar
        android:id="@+id/seek_alpha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="사진 어둡게" />
    <SeekBar
        android:id="@+id/seek_dim"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="80" />

    <TextView style="@style/SectionLabel" android:text="글자색" />
    <RadioGroup
        android:id="@+id/text_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <RadioButton android:id="@+id/rb_text_auto" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="자동" />
        <RadioButton android:id="@+id/rb_text_dark" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="어둡게" />
        <RadioButton android:id="@+id/rb_text_light" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="밝게" />
    </RadioGroup>

    <TextView style="@style/SectionLabel" android:text="위젯 문구" />
    <EditText
        android:id="@+id/input_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="예: 최애 생일까지 존버 중"
        android:inputType="text"
        android:maxLength="40"
        android:maxLines="1" />

    <Button
        android:id="@+id/btn_reset"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="꾸미기 전부 초기화"
        android:textColor="@color/sunday" />
</LinearLayout>
</ScrollView>
